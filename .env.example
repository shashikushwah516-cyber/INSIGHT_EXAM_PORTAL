# ==============================================================================
# Insight Exam Platform - Environment Configuration
# ==============================================================================

# Server Environment
# For local development: 5001. For Render: Render sets PORT automatically (defaults to 10000)
PORT=5001
NODE_ENV=development
HOST=0.0.0.0

# Database Configuration
# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/insight_exam_db
# Cloud MongoDB Atlas (for Render production):
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/insight_exam_db?retryWrites=true&w=majority

# Authentication Security
# Generate a strong 32+ character random string (Render blueprint can auto-generate this)
JWT_SECRET=insight_exam_super_secure_jwt_secret_key_2026_sih

# CORS Configuration (Optional)
# In unified mode (backend serves frontend), CORS is not needed.
# If hosting frontend & backend separately, specify allowed origins separated by commas:
# CORS_ORIGIN=https://my-app.onrender.com,http://localhost:5173

# Optional: Frontend API URL (Only required if hosting frontend separately on Render Static Site)
# VITE_API_URL=https://your-backend-service.onrender.com/api
